<section class="section-rich-text section-{{section.id}}">
  <div class="text-{{section.settings.text_alignment}}">
    {%- if section.settings.title != blank -%}
  	<{{section.settings.title_format}}>{{- section.settings.title -}}</{{section.settings.title_format}}>
    {%- endif -%}
    {%- if section.settings.paragraph != blank -%}
    <div>{{- section.settings.paragraph -}}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
    <a href="{{section.settings.button_ur}}" class="button">{{- section.settings.button_label -}}</a>
    {%- endif -%}
  </div>
</section>
{% schema %}
  {
    "name": "t:sections.rich-text.name",
    "settings": [
		{
			"type":"select",
			"id":"title_format",
			"label":"t:sections.all.title_format.name",
			"options":[
				{
					"label":"t:sections.all.title_format.option__1.label",
					"value":"h1"
				},
				{
					"label":"t:sections.all.title_format.option__2.label",
					"value":"h2"
				},
				{
					"label":"t:sections.all.title_format.option__3.label",
					"value":"h3"
				},
				{
					"label":"t:sections.all.title_format.option__4.label",
					"value":"h4"
				},
				{
					"label":"t:sections.all.title_format.option__5.label",
					"value":"h5"
				},
				{
					"label":"t:sections.all.title_format.option__6.label",
					"value":"h6"
				}
			],
			"default":"h2"
		},
		{
			"type":"text",
			"id":"title",
			"label":"t:sections.all.title"
		},
		{
			"type":"richtext",
			"id":"paragraph",
			"label":"t:sections.all.paragraph"
		},
		{
			"type":"text",
			"id":"button_label",
			"label":"t:sections.all.button_label"
		},
		{
			"type":"url",
			"id":"button_url",
			"label":"t:sections.all.button_url"
		},
		{
			"type":"select",
			"id":"text_alignment",
			"label":"t:sections.all.text_alignment.name",
			"options":[
				{
					"label":"t:sections.all.text_alignment.left.label",
					"value":"left"
				},
				{
					"label":"t:sections.all.text_alignment.center.label",
					"value":"center"
				},
				{
					"label":"t:sections.all.text_alignment.right.label",
					"value":"right"
				}
			]
		}
	],
	"presets":[
		{
			"name":"t:sections.rich-text.presets.name"
		}
	]
  }
{% endschema %}