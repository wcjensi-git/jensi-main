<script src="{{ 'ajaxinate.min.js' | asset_url }}"></script>
<script>
  createSingleInstanceOfJS('{{"collection-section.js" | asset_url}}', '.section-collection')                    
</script>
{{ 'collection-section.css' | asset_url | stylesheet_tag }}
{{ 'product-grid.css' | asset_url | stylesheet_tag }}
<noscript>
{{ 'product-grid.css' | asset_url | stylesheet_tag }}
</noscript>
{%- paginate collection.products by section.settings.product_limit -%}
<section class="section-collection section-id-{{section.id}}">
  {%- liquid
  	assign desktop_grid = section.settings.desktop_grid
    if section.settings.mob_grid   == 'two_column'
    	assign mobile_grid = 2
    else
    	assign mobile_grid = 1
    endif
  -%}
  <style>
    @media(min-width:992px){.collection-grid{grid-template-columns: repeat({{desktop_grid}}, minmax(0, 1fr));}}
    @media(max-width:991px){.collection-grid{grid-template-columns: repeat({{mobile_grid}}, minmax(0, 1fr));}}
  </style>
  {%- comment -%}<!-------------------Collection Filter-------------------------------->{%- endcomment -%}
  {%- if section.settings.enable_filter or section.settings.enable_sort -%}
  	{%- render 'collection-filter', section:section , block:block , collection:collection , results:collection -%}
  {%- endif -%}
  {%- comment -%}<!-------------------Product Grid------------------------------------->{%- endcomment -%}
  <div id="collection-grid" data-id="{{ section.id }}">
    {%- if collection.products.size == 0 -%}
    {{ 'sections.collection_template.empty' | t }}<br>
    {%- endif -%}  
    <div class="collection-grid" id="product-grid">
      {%- assign pagesize = paginate.page_size -%}
      {%- assign currentpage = current_page -%}
      {%- assign pagemultiply = pagesize | times:currentpage -%}
      {%- for product in collection.products -%}
        {% assign loopIndex = forloop.index %}
        {% assign current_page_count = paginate.current_page | minus: 1 %}
        {% assign paginateLimit = section.settings.product_limit | times: current_page_count %}
        {% assign loopIndex = forloop.index | plus: paginateLimit %}
        <div class="product-item">
          {%- render 'product-grid' , product:product -%}
        </div>
      {%- endfor -%}
      {%- render 'promo-image' , section:section , block:block , forloop:forloop.index , paginate:paginate -%}
    </div>
    <div id="AjaxinatePagination" data-text="{{'sections.collection_template.load_more' | t}}">
      {% if paginate.next %}
        <a href="{{ paginate.next.url }}" data-page="{{paginate.current_page}}">{{'sections.collection_template.load_more' | t}}</a>
      {% endif %}
    </div>
    {% comment %}
      {%- if paginate.pages > 1 -%}
      {%- render 'pagination', paginate: paginate, anchor: '' -%}
      {%- endif -%}
    {% endcomment %}
  </div>
  {%- comment -%}<!-------------------End Product Grid--------------------------------->{%- endcomment -%}
</section>
{%- if request.design_mode -%}
<script>
  document.addEventListener("shopify:section:load", function(event) {
  createSingleInstanceOfJS('{{"collection-section.js" | asset_url}}', '.section-collection')
  createSingleInstanceOfJS('{{"ajaxinate.min.js" | asset_url}}', '.section-collection')
  });
</script>
{%- endif -%}
{%- endpaginate -%}
