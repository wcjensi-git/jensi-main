<script>
  createSingleInstanceOfJS('{{"media-slider.js" | asset_url}}', '.section-media-slider')
  createSingleInstanceOfCSS('{{"media-slider.css" | asset_url}}', '.section-media-slider')
</script>
<noscript>
  {{ 'media-slider.css' | asset_url | stylesheet_tag }}
</noscript>
<div class="section-media-slider section-id-{{section.id}}">
  {%- assign is_graggable = false -%}
  {%- assign showarrows = false -%}
  {%- assign autoplay = false -%}
  {%- if section.settings.draggable_slider and section.blocks.size > 1 -%}
  	{%- assign is_graggable = true -%}
  {%- endif -%}
  {%- if section.settings.show_arrows and section.blocks.size > 1 -%}
  	{%- assign showarrows = true -%}
  {%- endif -%}
  {%- assign slider_play_time = section.settings.autoplay_time -%}
  {%- if slider_play_time != 0 and section.blocks.size > 1 -%}
  	{%- assign autoplay = true -%}
  {%- endif -%}
  <div class="media-slider swiper" datadata-id="{{section.id}}" data-single="{% if section.blocks.size == 1 %}true{% else %}false{% endif %}" data-draggable="{{is_graggable}}" data-arrows="{{showarrows}}" data-playtime="{{slider_play_time | times:1000}}" data-autoplay="{{autoplay}}">
    <div class="swiper-wrapper">
    {%- for block in section.blocks -%}
      {%- render 'media-slider' , section:section , block:block -%}
    {%- endfor -%}
    </div>
    {%- if showarrows -%}
    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
    {%- endif -%}
  </div>
</div>
{%- if request.design_mode -%}
<script>
  document.addEventListener("shopify:section:load", function(event) {
   createSingleInstanceOfJS('{{"media-slider.js" | asset_url}}', '.section-media-slider')
   createSingleInstanceOfCSS('{{"media-slider.css" | asset_url}}', '.section-media-slider')
   mediaslider();
  });
</script>
{%- endif -%}
