{{ 'cart.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- assign product_image = section.settings.enable_product_image -%}
{%- assign product_quantity = section.settings.enable_quantity -%}
<section class="section-cart section-id-{{section.id}}">
{%- if section.settings.enable_cart_title -%}
  <div class="text-{{section.settings.text_alignment}}">
    {%- if section.settings.cart_title != blank -%}
    <h1>{{- section.settings.cart_title -}}</h1>
    {%- else -%}
    <h1>{{ 'sections.cart.title' | t }}</h1>
    {%- endif -%}
  </div>
{%- endif -%}
{%- if cart != empty -%}
  <form action="{{ routes.cart_url }}" method="post" id="cart">    
    <div class="cart-item-wrap">
      <div class="cart-top">
      <div class="cart-row heading-cart-row">
        {%- if product_image -%}
        <div class="cart-row-left"><h5>{{'sections.cart.headings.product' | t}}</h5></div>
        {%- endif -%}
        <div class="cart-row-right">
          <div class="cart-title">&nbsp;</div>
          <div class="cart-price"><h5>{{'sections.cart.headings.price' | t}}</h5></div>
          <div class="cart-quantity"><h5>{{'sections.cart.headings.quantity' | t}}</h5></div>
          <div class="cart-size"><h5>{{'sections.cart.headings.size' | t}}</h5></div>
        </div>
      </div>
      {%- for item in cart.items -%}
      <div class="cart-row">
        {%- if product_image -%}
        <div class="cart-row-left">
          <a href="{{ item.url }}">
            {%- if item.image -%}
            <img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.image.alt | escape }}" loading="lazy" />
            {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </a>
        </div>
        {%- endif -%}
        <div class="cart-row-right">
          <div class="cart-title">
            <p><a href="{{ item.url }}" aria-hidden="true" tabindex="-1">{{ item.product.title | escape }}</a></p>
            <div class="d-block d-md-none">
            {%- if item.product.has_only_default_variant == false or item.properties.size != 0 or item.selling_plan_allocation != nil -%}
            <div>
              {%- if item.product.has_only_default_variant == false -%}
                {%- for option in item.options_with_values -%}
                <div>{{- option.name -}}:{{- option.value -}}</div>
                {%- endfor -%}
              {%- endif -%}
              {%- for property in item.properties -%}
                {%- assign property_first_char = property.first | slice: 0 -%}
                {%- if property.last != blank and property_first_char != '_' -%}
                <div>{{ property.first }}:                 
                    {%- if property.last contains '/uploads/' -%}
                    <a href="{{ property.last }}" class="link" target="_blank">
                      {{- property.last | split: '/' | last -}}
                    </a>
                    {%- else -%}
                    {{ property.last }}
                    {%- endif -%}
                </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <p>{{ item.selling_plan_allocation.selling_plan.name }}</p>
            {%- endif -%}
            <ul class="discounts" role="list" aria-label="{{ 'customer.order.discount' | t }}">
              {%- for discount in item.discounts -%}
              <li class="discounts-discount">{%- render 'icon-discount' -%}{{- discount.title -}}</li>
              {%- endfor -%}
            </ul>
            </div>
          </div>
          <div class="cart-price">
            {%- if item.original_price != item.final_price -%}
            <div>
              {{ item.final_price | money }}<span class="cart-compare">{{- item.original_price | money -}}</span>             
            </div>
            {%- else -%}                      
            {{ item.original_price | money }}
            {%- endif -%}
          </div>
          <div class="cart-quantity">
            {%- if product_quantity -%}
            <div class="quantity-box">
              <a href="javascript:void(0)" class="quantity-minus button">
				{%- render 'icon-minus' -%}
              </a>
              <div class="quantity-input">
                <input type="text"
                       name="updates[]"
                       value="{{ item.quantity }}"
                       min="0"
                       aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                       id="Quantity-{{ item.index | plus: 1 }}"
                       data-index="{{ item.index | plus: 1 }}">
              </div>
              <a href="javascript:void(0)" class="quantity-plus button">
				{%- render 'icon-plus' -%}
              </a>
            </div>
            {%- endif -%}
            <div class="cart-remove">
              <a href="{{ item.url_to_remove }}" aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}">
                {% render 'icon-remove' %}
              </a>
            </div>
          </div>
          <div class="cart-size">
            {%- if item.product.has_only_default_variant == false or item.properties.size != 0 or item.selling_plan_allocation != nil -%}
            <div>
              {%- if item.product.has_only_default_variant == false -%}
                {%- for option in item.options_with_values -%}
                <div>{{- option.name -}}:{{- option.value -}}</div>
                {%- endfor -%}
              {%- endif -%}
              {%- for property in item.properties -%}
                {%- assign property_first_char = property.first | slice: 0 -%}
                {%- if property.last != blank and property_first_char != '_' -%}
                <div>{{ property.first }}:                 
                    {%- if property.last contains '/uploads/' -%}
                    <a href="{{ property.last }}" class="link" target="_blank">
                      {{- property.last | split: '/' | last -}}
                    </a>
                    {%- else -%}
                    {{ property.last }}
                    {%- endif -%}
                </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <p>{{ item.selling_plan_allocation.selling_plan.name }}</p>
            {%- endif -%}
            <ul class="discounts" role="list" aria-label="{{ 'customer.order.discount' | t }}">
              {%- for discount in item.discounts -%}
              <li class="discounts-discount">{%- render 'icon-discount' -%}{{- discount.title -}}</li>
              {%- endfor -%}
            </ul>
          </div>
        </div>
      </div>
      {%- endfor -%}
      </div>
      <div class=" cart-total">
        <div class="final-total not-sticky">
          <h5>
            <span>{{'sections.cart.subtotal' | t}}</span><span>{{ cart.total_price | money_with_currency }}</span>
          </h5>
          <div>
            <input type="submit" name="update" class="button button-update" value="update">
            <button type="submit" id="checkout" class="cart-checkout-button button" name="checkout"{% if cart == empty %} disabled{% endif %} form="cart">
              {{ 'sections.cart.checkout' | t }}
            </button>
          </div>
        </div>
        {%- if section.settings.shopping_text != blank and section.settings.shopping_url != blank -%}
        <div>
          <a href="{{section.settings.shopping_url}}" class="button">{{- section.settings.shopping_text -}}</a>
        </div>
        {%- endif -%}
        {%- if section.settings.enable_payment -%}
          {%- render 'payments' -%}
        {%- endif -%}
      </div>
    </div>    
  </form>
{%- else -%}
  <div>
    <p>{{ 'sections.cart.empty' | t }}</p>
  </div>
{%- endif -%}  
</section>
{% schema %}
  {
    "name": "t:sections.cart-section.name",
    "settings": [
		{
			"type":"checkbox",
			"id":"enable_cart_title",
			"label":"t:sections.cart-section.settings.enable_cart_title.label",
			"default":true
		},
		{
			"type":"text",
			"id":"cart_title",
			"label":"t:sections.cart-section.settings.cart_title.label",
			"default":"Your Cart"
		},
		{
            "type":"select",
            "id":"text_alignment",
            "label":"t:sections.all.text_alignment.name",
            "options":[
                {
                  "label":"t:sections.all.text_alignment.left.label",
                  "value":"left"
                },
                {
                  "label":"t:sections.all.text_alignment.center.label",
                  "value":"center"
                },
                {
                  "label":"t:sections.all.text_alignment.right.label",
                  "value":"right"
                }
            ]
        },
		{
			"type":"checkbox",
			"id":"enable_product_image",
			"label":"t:sections.cart-section.settings.enable_product_image.label",
			"default":true
		},
		{
			"type":"checkbox",
			"id":"enable_quantity",
			"label":"t:sections.cart-section.settings.enable_quantity.label",
			"default":true
		},
		{
			"type":"checkbox",
			"id":"enable_payment",
			"label":"t:sections.cart-section.settings.enable_payment.label",
			"default":true
		},
		{
			"type":"text",
			"id":"shopping_text",
			"label":"t:sections.cart-section.settings.shopping_text.label"
		},
		{
			"type":"url",
			"id":"shopping_url",
			"label":"t:sections.cart-section.settings.shopping_url.label"
		}
	]
  }
{% endschema %}