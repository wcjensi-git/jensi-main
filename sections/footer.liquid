{{ 'footer.css' | asset_url | stylesheet_tag }}
<footer class="section-footer section-id-{{section.id}}">
  <div class="footer-main">
    <div class="footer-row">
    {%- for block in section.blocks -%}
      {%- render 'footer-blocks' , block:block , section:section -%}
    {%- endfor -%}
    </div>
  </div>
  {%- if section.settings.copyright != blank or section.settings.enable_payment -%}
  <div class="footer-copyright">
    <div class="copyright-row">
      {%- if section.settings.copyright != blank -%}
      <div><p class="copyright">{{ 'now' | date: "%Y" }} {{section.settings.copyright}}</p></div>
      {%- endif -%}
      {%- if section.settings.enable_payment -%}
      	{%- render 'payments' -%}
      {%- endif -%}
    </div>
  </div>
  {%- endif -%}
</footer>
{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
		"type":"text",
		"id":"copyright",
		"label":"t:sections.footer.settings.copyright.label"
	},
	{
		"type":"checkbox",
		"id":"enable_payment",
		"label":"t:sections.footer.settings.enable_payment.label",
		"default":true
	}
  ],
  "blocks":[
	{
		"name":"t:sections.footer.blocks.navigation.name",
		"type":"navigation",
		"settings":[
			{
				"type":"range",
				"id":"grid",
				"label":"t:sections.footer.blocks.grid",
				"min":1,
				"max":12,
				"default":2
			},
			{
				"type":"text",
				"id":"title",
				"label":"t:sections.footer.blocks.navigation.settings.title.label"
			},
			{
				"type":"link_list",
				"id":"menu",
				"label":"t:sections.footer.blocks.navigation.settings.menu.label"
			},
			{
				"type":"checkbox",
				"id":"hide_mobile",
				"label":"t:sections.footer.blocks.navigation.settings.hide_mobile.label"
			}
		]
	},
	{
		"name":"t:sections.footer.blocks.newsletter.name",
		"type":"newsletter",
		"settings":[
			{
				"type":"range",
				"id":"grid",
				"label":"t:sections.footer.blocks.grid",
				"min":1,
				"max":12,
				"default":6
			},
			{
				"type":"html",
				"id":"html",
				"label":"t:sections.footer.blocks.newsletter.settings.title.label"
			}
		]
	}
  ]
}
{% endschema %}