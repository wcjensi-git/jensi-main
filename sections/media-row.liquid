<script>
  createSingleInstanceOfCSS('{{"media-row.css" | asset_url}}', '.section-media-row')
</script>
<noscript>{{ 'media-row.css' | asset_url | stylesheet_tag }}</noscript>
<style>
  @media(min-width:992px){
    .section-id-{{section.id}} .snippet-media-row{
    {%- case section.settings.desktop_height -%}
    	{%- when 'adapt_media' -%}
    	height:auto;
    	{%- when 'full_height' -%}
      	height:100vh;min-height:200px;
    	{%- when 'square' -%}
      	aspect-ratio: 1/1;
    	{%- when 'portrait' -%}
        aspect-ratio: 4/5;
    	{%- when 'landscape' -%}
        aspect-ratio: 3/2;
    {%- endcase -%}
    }
  }
  @media(max-width:991px){
  	.section-id-{{section.id}} .snippet-media-row{
    {%- case section.settings.mobile_height -%}
    	{%- when 'adapt_media' -%}
    	height:auto;
    	{%- when 'full_height' -%}
      	height:100vh;min-height:200px;
    	{%- when 'square' -%}
      	aspect-ratio: 1/1;
    	{%- when 'portrait' -%}
        aspect-ratio: 4/5;
    	{%- when 'landscape' -%}
        aspect-ratio: 3/2;
    {%- endcase -%}
    }
    {%- if section.settings.reverse_direction_mobile -%}
    .section-id-{{section.id}} .media-row{flex-direction: column-reverse;}
    {%- endif -%}
  }
</style>
<div class="section-media-row section-id-{{section.id}}">
  <div class="media-row">
  {%- for block in section.blocks -%}
    {%- render 'media-row',block:block,section:section -%}
  {%- endfor -%}
  </div>
</div>
{%- if request.design_mode -%}
<script>
  document.addEventListener("shopify:section:load", function(event) {
  createSingleInstanceOfCSS('{{"media-row.css" | asset_url}}', '.section-media-row')
  });
</script>
{%- endif -%}
