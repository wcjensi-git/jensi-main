<div class="cart-drawer" id="cart-drawer">
  <button class="cart-drawer-close">{%- render 'icon-close' -%}</button>
  <form action="{{ routes.cart_url }}" method="post" id="cart">
  <div class="drawer-header">
    <h4>{{'sections.cart.title' | t}} {% if cart.item_count > 0 %}({{cart.item_count}}){% endif %}</h4>
  </div>
  {%- if cart.item_count > 0 -%}
  <div class="drawer-middle">
    {%- for item in cart.items -%}
    <div class="item-row">
      <div class="item-left">
        <a href="{{item.url}}" class="item-image">
          {%- if item.image -%}
          <img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.image.alt | escape }}" loading="lazy" />
          {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </a>
      </div>
      <div class="item-right">
        <div>
          <h4><a href="{{item.url}}">{{item.product.title}}</a></h4>
          <div>
          {%- if item.product.has_only_default_variant == false or item.properties.size != 0 or item.selling_plan_allocation != nil -%}
            {%- if item.product.has_only_default_variant == false -%}
            {%- for option in item.options_with_values -%}
            <div>{{- option.name -}}:{{- option.value -}}</div>
            {%- endfor -%}
            {%- endif -%}
          {%- endif -%}
          </div>
          <p>
            {%- if item.original_price != item.final_price -%}
            {{- item.final_price | money -}}<span class="cart-compare">{{- item.original_price | money -}}</span>                     
            {%- else -%}                      
            {{- item.original_price | money -}}
            {%- endif -%}
          </p>
        </div>
        <div><a href="javascript:void(0)" class="item-remove" data-line="{{forloop.index}}">{% render 'icon-remove' %}</a></div>
      </div>
    </div>
    {%- endfor -%}
  </div>
  <div class="drawer-footer">
    <h5><span>{{'sections.cart.subtotal' | t}}</span><span>{{ cart.total_price | money_with_currency }}</span></h5>
    <button type="submit" id="checkout" class="cart-checkout-button button button-full" name="checkout"{% if cart == empty %} disabled{% endif %} form="cart">{{ 'sections.cart.checkout' | t }}</button>
    {%- if settings.cart_button_label != blank -%}
    <a href="{{ routes.cart_url }}" class="button button-full">{{settings.cart_button_label}}</a>
    {%- endif -%}
  </div>
  {%- else -%}
    <div>{{'sections.cart.empty' | t}}</div>
  {%- endif -%}
  </form>
</div>