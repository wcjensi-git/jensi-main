<div>
  <div class="password-header">   
    <h1>{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}
    <div class="password-content">
      {{ shop.password_message }}
    </div>
    {%- endif -%}
    <password-modal>
      <details class="password-modal modal">
        <summary class="modal-toggle" aria-haspopup="dialog">
          <div class="modal-toggle-open">
            {{ 'general.password_page.login_password_button' | t }}
          </div>
          <div class="modal-toggle-close" aria-hidden="true">
            {% render 'icon-close' %}
          </div>
        </summary>
        <div
          class="modal-ontent"
          role="dialog"
          aria-labelledby="DialogHeading"
          aria-modal="true"
        >
          <div class="password-modal-content" tabindex="-1">
            {% comment %}
            <button type="button" class="modal-close-button link" aria-label="{{ 'accessibility.close' | t }}">
              {% render 'icon-close' %}
            </button>
            {% endcomment %}
            <h2 class="password-modal-content-heading" id="DialogHeading">
              {{ 'general.password_page.login_form_heading' | t }}
            </h2>
            {%- form 'storefront_password', class: 'password-form' -%}
              <div class="{% if form.errors %} password-field--error{% endif %}">
                <input
                  type="password"
                  name="password"
                  id="Password"
                  autocomplete="current-password"
                  {% if form.errors %}
                    aria-invalid="true"
                    aria-describedby="password-error"
                  {%- endif -%}
                  placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
                >
                {%- comment -%}<label for="{{ 'general.password_page.login_form_password_label' | t }}">{{ 'general.password_page.login_form_password_placeholder' | t }}</label>{%- endcomment -%}
                {%- if form.errors -%}
                  <div id="password-error" role="status">
                    <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                    <span class="form-message">{{ 'general.password_page.login_form_error' | t }}</span>
                  </div>
                {%- endif -%}
              </div>
              <button name="commit" class="button">
                {{ 'general.password_page.login_form_submit' | t }}
              </button>
            {%- endform -%}
            <small>{{ 'general.password_page.admin_link_html' | t }}</small>
          </div>
        </div>
      </details>
    </password-modal>
  </div>
</div>

{% schema %}
{
  "name": "Password Header",
  "settings": [
    
  ]
}
{% endschema %}
