<div class="snippet-header-nav">
  <ul class="list-menu list--inline" role="list">
  {%- for link in section.settings.menu.links -%}
    <li class="{% if link.active %}active {% endif %}{% if link.levels == 2 %}mega-list{% elsif link.levels == 1 %}dropdown-list{% endif %}">
      <a href="{{link.url}}">{{link.title}}</a>
      {%- if link.levels == 2 -%}
      <div class="megamenu">
        <div class="megamenu-inner">
          <div class="container header-container">
            <div class="mega-main-grid">
              <div class="mega-left">                
                  {%- for child in link.links -%}
                  <div class="mega-nav">
                    <p class="mega-title"><a href="{{child.url}}">{{child.title}}</a></p>
                    <ul class="mega-listmenu" role="list">
                      {%- for grand in child.links -%}
                      <li><a href="{{grand.url}}">{{grand.title}}</a></li>
                      {%- endfor -%}
                    </ul>
                  </div>
                  {%- endfor -%}              
              </div>
              {%- assign megacount = 0 -%}
              {%- assign lnktitle = link.title | handle -%}                  
              {%- for block in section.blocks -%}
              	{%- if block.type == 'mega-images' -%}
              		{%- assign mega_maintitle = block.settings.title | handle -%}                            
                  	{%- if lnktitle == mega_maintitle -%}
              		{%- for i in (1..3) -%}
                      {%- capture temp_image -%}image_{{i}}{%- endcapture -%}
                      	{%- assign mega_image = block.settings[temp_image] -%}
                      {%- capture temp_title -%}title_{{i}}{%- endcapture -%}
                      	{%- assign mega_title = block.settings[temp_title] -%}
                      {%- capture temp_url -%}url_{{i}}{%- endcapture -%}
                      	{%- assign mega_url = block.settings[temp_url] -%}              
                      {%- if mega_image != blank or mega_title != blank or mega_url != blank -%}
              			{%- assign megacount = megacount | plus:1 -%}
              		  {%- endif -%}
              		{%- endfor -%}
              		{%- endif -%}              		
              	{%- endif -%}
              {%- endfor -%}
              {%- if megacount > 1 -%}
              <div class="mega-right">                
                  {%- for block in section.blocks -%}
                  	{%- if block.type == 'mega-images' -%}
                  	  {%- assign mega_maintitle = block.settings.title | handle -%}
                  	  {%- if lnktitle == mega_maintitle -%}
                        {%- for i in (1..3) -%}
                          {%- capture temp_image -%}image_{{i}}{%- endcapture -%}
                              {%- assign mega_image = block.settings[temp_image] -%}
                          {%- capture temp_title -%}title_{{i}}{%- endcapture -%}
                              {%- assign mega_title = block.settings[temp_title] -%}
                          {%- capture temp_url -%}url_{{i}}{%- endcapture -%}
                              {%- assign mega_url = block.settings[temp_url] -%}
                          {%- if mega_image != blank or mega_title != blank or mega_url != blank -%}
                          <div class="mega-image-grid">
                            <div class="mega-image-box">
                              {%- if mega_url != blank -%}
                              <a href="{{mega_url}}" class="mega-image">
                              {%- else -%}
                              <div class="mega-image">
                              {%- endif -%}
                                {%- if mega_image != blank -%}
                                  {{mega_image | image_url:width:300 | image_tag : loading:'lazy' , class:'full-image'}}
                                {%- else -%}
                                  {{ 'image' | placeholder_svg_tag: 'svg-full placeholder-svg' }}
                                {%- endif -%}
                              {%- if mega_url == blank -%}
                              </div>
                              {%- else -%}
                              </a>
                              {%- endif -%}
                              {%- if mega_title != blank -%}
                              <p>{{mega_title}}</p>
                              {%- endif -%}
                            </div>
                          </div>
                          {%- endif -%}
                        {%- endfor -%}
                  	  {%- endif -%}
                  	{%- endif -%}
                  {%- endfor -%}               
              </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
      {%- elsif link.levels == 1 -%}
      <div class="dropdown-menu">
        <ul role="list">
        {%- for child in link.links -%}
          <li><a href="{{child.url}}">{{child.title}}</a></li>
        {%- endfor -%}
        </ul>
      </div>
      {%- endif -%}
    </li>
  {%- endfor -%}
  </ul>
</div>