{%- if paginate.parts.size > 0 -%}
<div class="snippet-pagination">
  <ul role="list" class="list--inline">
    {%- if paginate.previous -%}
    <li><a href="{{ paginate.previous.url }}{{ anchor }}" aria-label="{{ 'general.pagination.previous' | t }}"></a></li>
    {%- endif -%}
    {%- for part in paginate.parts -%}
    <li>
      {%- if part.is_link -%}
      <a href="{{ part.url }}{{ anchor }}"aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
      {%- else -%}
      {%- if part.title == paginate.current_page -%}
      <span aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</span>
      {%- else -%}
      <span>{{ part.title }}</span>
      {%- endif -%}
      {%- endif -%}
    </li>
    {%- endfor -%}
    {%- if paginate.next -%}
    <li><a href="{{ paginate.next.url }}{{ anchor }}" aria-label="{{ 'general.pagination.next' | t }}" ></a></li>
    {%- endif -%}
  </ul>
</div>
{%- endif -%}