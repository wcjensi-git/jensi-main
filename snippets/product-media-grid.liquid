{%- assign media_column = section.settings.media_column -%}
<style>
  .media-grid-inner{
    {%- if section.settings.media_ratio == '100vh' -%}
    height:100vh;min-height:400px;
    {%- else -%}
    aspect-ratio:{{section.settings.media_ratio}};
    {%- endif -%}
  }
  @media(min-width:992px){
    .media-grid{grid-template-columns: repeat({{media_column}}, minmax(0, 1fr));}
  }
</style>
{%- assign img_zoom = false -%}
{%- if section.settings.enable_zoom -%}
	{%- assign img_zoom = true -%}
{%- endif -%}
<div class="media-grid medialist">
  {%- for media in product.media -%}
  <div class="media-grid-column">
	<div class="media-grid-inner">
    {%- case media.media_type -%}
    {%- when 'image' -%}
    	<img src="{{ media | img_url: 'master'}}" alt="{{ media.alt }}" loading="lazy" {% if img_zoom %}class="product-image-zoom"{% endif %}>
    {%- when 'external_video' -%}
      {%- assign video_class = 'js-' | append: media.host -%}
      {%- if media.host == 'youtube' -%}
      {{- media | external_video_url: autoplay: true, mute: true, loop: true, playlist: media.external_id | external_video_tag: class: video_class, loading: "lazy" -}}
      {%- else -%}
      {{- media | external_video_url: autoplay: true, muted: true, loop: true | external_video_tag: class: video_class, loading: "lazy" -}}
      {%- endif -%}    
    {%- when 'video' -%}
    {{- media | video_tag: autoplay:true, mute:true , loop:true -}}
    {%- when 'model' -%}
    {{- media | model_viewer_tag -}}
    {%- else -%}
    {{- media | media_tag -}}
    {%- endcase -%}
    </div>
  </div>
  {%- endfor -%}
</div>